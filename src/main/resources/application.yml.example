server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/openmanus?useSSL=false&serverTimezone=UTC&characterEncoding=utf8&allowPublicKeyRetrieval=true
    username: root
    password: YOUR_DB_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver
  data:
    redis:
      host: localhost
      port: 6379
      timeout: 3000ms

mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  type-aliases-package: com.openmanus.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl

# LLM 配置
llm:
  api-key: YOUR_API_KEY
  base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
  model: qwen3-max
  temperature: 0.7
  max-tokens: 4096

# Agent 配置
agent:
  max-steps: 20
  max-observe: 3000
  workspace-dir: ./workspace
  system-prompt: |
    You are Manus, an all-capable AI assistant aimed at solving any task the user presents.
    You have access to various tools. Use them strategically to complete tasks efficiently.
    Always analyze tool results carefully before deciding next steps.
    When the task is fully complete, call the terminate tool with a summary of what was accomplished.
